# Copy to .env and adjust. Every variable is optional.

# --- Storage and inputs ------------------------------------------------------------
OPSCENTER_DB_PATH=.opscenter/opscenter.db
# OPSCENTER_PRICING_FILE=configs/pricing.example.json
# OPSCENTER_APPS_FILE=configs/apps.example.yaml

# --- Privacy -------------------------------------------------------------------------
# Secret salt for user and input hashes. Set a long random value and keep it stable.
OPSCENTER_HASH_SALT=

# --- Ingestion limits -------------------------------------------------------------------
OPSCENTER_MAX_LINE_BYTES=200000
OPSCENTER_MAX_LINES=2000000

# --- Analysis thresholds (JSON; any subset) ---------------------------------------------------
# OPSCENTER_THRESHOLDS={"min_samples": 20, "psi_moderate": 0.1, "psi_significant": 0.25}

# --- Models used by `opsctl eval run` ----------------------------------------------------------
# llm_provider: none | openai | anthropic
OPSCENTER_LLM_PROVIDER=none
OPSCENTER_OPENAI_API_KEY=
OPSCENTER_OPENAI_BASE_URL=https://api.openai.com/v1
OPSCENTER_OPENAI_CHAT_MODEL=gpt-4o-mini
OPSCENTER_ANTHROPIC_API_KEY=
OPSCENTER_ANTHROPIC_BASE_URL=https://api.anthropic.com
OPSCENTER_ANTHROPIC_MODEL=claude-sonnet-5
OPSCENTER_ANTHROPIC_MAX_TOKENS=1024

# --- Alert delivery -------------------------------------------------------------------------------
# OPSCENTER_WEBHOOK_URL=https://hooks.example.com/services/...

# --- Networking ---------------------------------------------------------------------------------
OPSCENTER_HTTP_TIMEOUT_SECONDS=30
OPSCENTER_RETRY_ATTEMPTS=3
OPSCENTER_RETRY_MIN_WAIT=0.5
OPSCENTER_RETRY_MAX_WAIT=8

# --- Logging ---------------------------------------------------------------------------------------
OPSCENTER_LOG_LEVEL=WARNING
OPSCENTER_LOG_JSON=true
